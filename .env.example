# ── Required ──────────────────────────────────────────────────────────────────

# NAT MASQUERADE subnet — must match ipv4-network in ocserv.conf
VPN_NETWORK=192.168.1.0/24

# ── Prometheus exporter (optional) ───────────────────────────────────────────

# Enable ocserv-exporter (0 = disabled, 1 = enabled)
#EXPORTER_ENABLED=0

# Delay between occtl scrapes
#EXPORTER_INTERVAL=30s

# HTTP listen address
#EXPORTER_BIND=127.0.0.1:8000
