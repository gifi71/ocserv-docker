## (optional) 1 - enable ocserv-exporter, default: 0
# EXPORTER_ENABLED=0

## (optional) default ocserv-exporter delay between occtl scrape, default: 30s
# EXPORTER_INTERVAL=30s

## (optional) ocserv-exporter prometheus HTTP listen IP and port, default: 127.0.0.1:8000
# EXPORTER_BIND=127.0.0.1:8000

## (optional) restrict NAT MASQUERADE to VPN subnet; if unset, broad rule is used
# VPN_NETWORK=192.168.1.0/24
