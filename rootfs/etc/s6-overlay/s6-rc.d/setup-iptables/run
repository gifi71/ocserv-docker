#!/command/with-contenv bash
set -e

echo "[INFO] Firewall configuration started"

if [ -z "${VPN_NETWORK:-}" ]; then
  echo "[ERROR] VPN_NETWORK is not set. Refusing to create a broad MASQUERADE rule." >&2
  exit 1
fi

if [ "$(cat /proc/sys/net/ipv4/ip_forward)" != "1" ]; then
  echo "[WARN] net.ipv4.ip_forward is disabled, VPN clients won't reach external networks" >&2
fi

echo "[INFO] Enabling NAT forwarding for VPN subnet ${VPN_NETWORK}..."
iptables -t nat -C POSTROUTING -s "$VPN_NETWORK" -j MASQUERADE 2>/dev/null \
  || iptables -t nat -A POSTROUTING -s "$VPN_NETWORK" -j MASQUERADE

iptables -C FORWARD -s "$VPN_NETWORK" -j ACCEPT 2>/dev/null \
  || iptables -A FORWARD -s "$VPN_NETWORK" -j ACCEPT

iptables -C FORWARD -d "$VPN_NETWORK" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
  || iptables -A FORWARD -d "$VPN_NETWORK" -m state --state RELATED,ESTABLISHED -j ACCEPT

iptables -C FORWARD -s "$VPN_NETWORK" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null \
  || iptables -A FORWARD -s "$VPN_NETWORK" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu

iptables -C FORWARD -d "$VPN_NETWORK" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null \
  || iptables -A FORWARD -d "$VPN_NETWORK" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu

echo "[INFO] Firewall configured"
