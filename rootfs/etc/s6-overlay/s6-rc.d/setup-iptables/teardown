#!/command/with-contenv bash
set -e

echo "[INFO] Firewall teardown started"

if [ -n "${VPN_NETWORK:-}" ]; then
  iptables -t nat -D POSTROUTING -s "$VPN_NETWORK" -j MASQUERADE 2>/dev/null || true
  iptables -D FORWARD -s "$VPN_NETWORK" -j ACCEPT 2>/dev/null || true
  iptables -D FORWARD -d "$VPN_NETWORK" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
  iptables -D FORWARD -s "$VPN_NETWORK" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true
  iptables -D FORWARD -d "$VPN_NETWORK" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true
fi

echo "[INFO] Firewall teardown complete"
