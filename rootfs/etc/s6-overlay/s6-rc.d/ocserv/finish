#!/command/with-contenv bash

MAX_CRASHES=5
CRASH_FILE=/tmp/ocserv-crash-count

echo "[INFO] ocserv stopped (exit_code=$1, signal=$2)"

if [ "$1" -eq 0 ]; then
  rm -f "$CRASH_FILE"
  exit 0
fi

count=$(cat "$CRASH_FILE" 2>/dev/null || echo 0)
count=$((count + 1))
echo "$count" > "$CRASH_FILE"

echo "[WARN] ocserv crash #${count}/${MAX_CRASHES}"

if [ "$count" -ge "$MAX_CRASHES" ]; then
  echo "[FATAL] ocserv crashed ${MAX_CRASHES} consecutive times, halting container" >&2
  /run/s6/basedir/bin/halt
fi
